                ],
                "discovery_rules": [
                    {
                        "uuid": "217ab74655ed4bfbb00fd5be0ed076af",
                        "name": "scitq: worker discovery",
                        "type": "DEPENDENT",
                        "key": "scitq.worker.discovery",
                        "delay": "0",
                        "lifetime": "2h",
                        "item_prototypes": [
                            {
                                "uuid": "57e8b390fb8f4eb896e41704648b95fc",
                                "name": "scitq: worker {#WORKER_NAME} active-task drift",
                                "type": "DEPENDENT",
                                "key": "scitq.worker.drift[{#WORKER_ID}]",
                                "delay": "0",
                                "value_type": "FLOAT",
                                "preprocessing": [
                                    {
                                        "type": "PROMETHEUS_PATTERN",
                                        "parameters": [
                                            "scitq_worker_active_tasks_drift{worker_id=\"{#WORKER_ID}\"}",
                                            "value",
                                            ""
                                        ]
                                    }
                                ],
                                "master_item": {
                                    "key": "scitq.metrics.raw"
                                },
                                "trigger_prototypes": [
                                    {
                                        "uuid": "5079e2f38f4f407a969b8dedf7756bb4",
                                        "expression": "min(/Template App scitq/scitq.worker.drift[{#WORKER_ID}],15m) > 0 or max(/Template App scitq/scitq.worker.drift[{#WORKER_ID}],15m) < 0",
                                        "name": "scitq: worker {#WORKER_NAME} watchdog drift",
                                        "priority": "WARNING"
                                    }
                                ]
                            },
                            {
                                "uuid": "e1dc2132389c4218ba2b874f6b1cb27f",
                                "name": "scitq: worker {#WORKER_NAME} idle seconds",
                                "type": "DEPENDENT",
                                "key": "scitq.worker.idle_seconds[{#WORKER_ID}]",
                                "delay": "0",
                                "value_type": "FLOAT",
                                "preprocessing": [
                                    {
                                        "type": "PROMETHEUS_PATTERN",
                                        "parameters": [
                                            "scitq_worker_idle_seconds{worker_id=\"{#WORKER_ID}\"}",
                                            "value",
                                            ""
                                        ]
                                    }
                                ],
                                "master_item": {
                                    "key": "scitq.metrics.raw"
                                },
                                "trigger_prototypes": [
                                    {
                                        "uuid": "cf93f808ef0e4ce5b4e34a0854af8e18",
                                        "expression": "{#PERMANENT}=\"false\" and min(/Template App scitq/scitq.worker.idle_seconds[{#WORKER_ID}],5m) > 600",
                                        "name": "scitq: worker {#WORKER_NAME} leaked (idle > 2\u00d7 idle_timeout)",
                                        "priority": "HIGH"
                                    }
                                ]
                            }
                        ],
                        "master_item": {
                            "key": "scitq.metrics.raw"
                        },
                        "lld_macro_paths": [
                            {
                                "lld_macro": "{#PERMANENT}",
                                "path": "$.permanent"
                            },
                            {
                                "lld_macro": "{#WORKER_ID}",
                                "path": "$.worker_id"
                            },
                            {
                                "lld_macro": "{#WORKER_NAME}",
                                "path": "$.worker_name"
                            }
                        ],
                        "preprocessing": [
                            {
                                "type": "PROMETHEUS_TO_JSON",
                                "parameters": [
                                    "scitq_worker_idle_seconds"
                                ]
                            },
                            {
                                "type": "JSONPATH",
                                "parameters": [
                                    "$[*].labels"
                                ]
                            }
                        ]
                    }
                ]
            }
        ],
        "triggers": [
            {
                "uuid": "eda05d95e05248f6bd3ed6e9d6f0c957",
                "expression": "last(/Template App scitq/scitq.db.in_use) * 100 / last(/Template App scitq/scitq.db.open) > 80",
                "name": "scitq: DB pool > 80% in use",
                "priority": "WARNING"
            }
        ]
    }
